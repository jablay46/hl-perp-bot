# ---------------------------------------------------------------------------
# hl-perp-bot configuration
# ---------------------------------------------------------------------------

# testnet | mainnet
HL_NETWORK=testnet

# paper | live
#   paper = real market data, simulated fills, no keys, no risk. Default.
#   live  = real orders. Requires keys AND HL_ALLOW_LIVE=true.
HL_MODE=paper

# Hard interlock. Live trading is refused unless this is exactly "true".
HL_ALLOW_LIVE=false

# Market
HL_COIN=BTC
HL_LEVERAGE=5
HL_MARGIN_MODE=cross          # cross | isolated

# Strategy: ALO = post-only market making inside the touch, IOC = taker.
HL_ORDER_TIF=ALO
HL_SPREAD_BPS=2.0             # ALO: quote this many bps inside the touch
HL_HORIZON=60                 # seconds of context handed to the model

# Keys. Leave empty in paper mode.
# Preferred: an API/agent wallet (can trade, cannot withdraw).
HL_ACCOUNT_ADDRESS=
HL_AGENT_PRIVATE_KEY=
# Only used if you have no agent wallet. Never use a main wallet for a bot.
HL_PRIVATE_KEY=

# Risk
HL_RISK_PCT=0.01              # fraction of equity risked per trade
HL_MAX_LEVERAGE=10            # exchange cap for the asset (informational)
HL_MAINTENANCE_LEVERAGE=2.0   # maintenance-margin assumption for liq distance
HL_MAX_DRAWDOWN_PCT=10        # kill-switch: stop trading past this drawdown
HL_MIN_LIQ_DISTANCE_PCT=15    # refuse orders that leave liq this close
HL_MAX_NOTIONAL_PCT=50        # cap position notional as % of equity
HL_HOLD_SIGNAL=0.3            # momentum: |signal| below this sends no order (hold).
                              # 0 disables the band and always trades. Raise it to
                              # trade less and only when the edge is clear.

# Take-profit / stop-loss bracket (reduce-only). Off by default.
HL_TP_SL=false
HL_TP_PCT=0.02                # take profit this far from the mark
HL_SL_PCT=0.01                # stop loss this far from the mark
HL_TRIGGER_BUFFER_BPS=5.0     # minimum gap kept between trigger and mark/liq

# Model: momentum | openai
#   momentum = deterministic, no key, no network. Good default for a loop.
#   openai   = any OpenAI-compatible chat completions endpoint (OpenAI,
#              OpenRouter, Groq, Together, vLLM...).
HL_MODEL=momentum
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
HL_MODEL_ID=gpt-4o-mini

# JSON mode. Most OpenRouter free models reject `response_format`, so set this
# to false for them; the reply is parsed leniently either way.
HL_LLM_JSON_MODE=true

# Retries for 429 / 5xx before falling back to momentum. `Retry-After` is
# honoured; otherwise exponential backoff from HL_LLM_RETRY_BASE (capped 30s).
HL_LLM_MAX_RETRIES=2
HL_LLM_RETRY_BASE=0.5

# --- OpenRouter example (free model) ---------------------------------------
# HL_MODEL=openai
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# HL_MODEL_ID=google/gemma-4-31b-it:free
# HL_LLM_JSON_MODE=false
# Free models are rate limited and slow; raise HL_INTERVAL to stay under the cap.

# Dashboard / cadence
HL_PORT=8787
HL_INTERVAL=2.0               # seconds between decisions
